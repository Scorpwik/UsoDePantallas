---
import type { CollectionEntry } from 'astro:content';
import EntradaDiario from './EntradaDiario.astro';

interface Props {
  categorias: CollectionEntry<'categorias'>[];
  diario: CollectionEntry<'diario'>[];
}

const { categorias, diario } = Astro.props;

const etiquetas = Object.fromEntries(categorias.map((cat) => [cat.id, cat.data.titulo]));

const grupos = categorias.map((cat) => ({
  ...cat,
  entradas: diario.filter((entrada) =>
    (entrada.data.categorias as string[]).includes(cat.id),
  ),
}));
---

<section id="categorias" class="seccion categorias-seccion">
  <div class="envolvente">
    <header data-bloque>
      <span class="num-seccion">07 · Categorías culturales</span>
      <h2 class="titulo-seccion">Categorías culturales</h2>
      <p class="prosa mt-6">
        Tres lecturas del material. Cada tarjeta se abre y muestra las entradas del diario asociadas.
      </p>
    </header>

    <div class="categorias-stage mt-10">
      <div class="categorias-deck" data-cat-deck>
        {
          grupos.map((cat, i) => (
            <button
              type="button"
              class="cat-card tarjeta"
              data-cat-card
              data-cursor-grow
              data-cat-id={cat.id}
              style={`--cat-color: ${cat.data.color}`}
              aria-controls={`panel-${cat.id}`}
              aria-expanded="false"
            >
              <span class="cat-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="subtitulo mt-6">{cat.data.titulo}</h3>
              <p class="mt-4 text-left text-arena">{cat.data.descripcion}</p>
            </button>
          ))
        }
      </div>

      {
        grupos.map((cat) => (
          <article
            id={`panel-${cat.id}`}
            class="cat-panel"
            data-cat-panel
            data-cat-id={cat.id}
            aria-hidden="true"
            role="dialog"
            aria-label={cat.data.titulo}
          >
            <div class="flex shrink-0 items-start justify-between gap-8">
              <div>
                <p class="text-sm font-semibold" style={`color: ${cat.data.color}`}>
                  {cat.data.titulo}
                </p>
                <p class="mt-3 max-w-[680px] text-arena">{cat.data.descripcion}</p>
              </div>
              <button
                type="button"
                class="btn-pildora btn-pildora--ghost shrink-0"
                data-cerrar-categoria
                aria-label={`Cerrar ${cat.data.titulo}`}
              >
                Cerrar
              </button>
            </div>
            <div class="cat-panel-entradas">
              {cat.entradas.length > 0 ? (
                cat.entradas.map((entrada) => (
                  <EntradaDiario entrada={entrada} compacta etiquetas={etiquetas} />
                ))
              ) : (
                <p class="text-arena">Aún no hay entradas asociadas a esta categoría.</p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
