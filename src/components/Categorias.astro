---
import type { CollectionEntry } from 'astro:content';
import EntradaDiario from './EntradaDiario.astro';

interface Props {
  categorias: CollectionEntry<'categorias'>[];
  diario: CollectionEntry<'diario'>[];
}

const { categorias, diario } = Astro.props;

const grupos = categorias.map((cat) => ({
  ...cat,
  entradas: diario.filter((entrada) =>
    (entrada.data.categorias as string[]).includes(cat.id),
  ),
}));
---

<section id="categorias" class="seccion categorias-seccion">
  <div class="envolvente categorias-pin">
    <header class="relative z-10">
      <p class="kicker">06</p>
      <h2 class="titulo-seccion">Categorías culturales</h2>
      <p class="prosa mt-6">
        Tres lecturas del material. Al seguir el scroll, la sección se fija y cada tarjeta se abre
        como un panel de cristal. Cerrar vuelve a la vista de tarjetas.
      </p>
    </header>

    <div class="categorias-deck relative z-[1]">
      {
        grupos.map((cat, i) => (
          <button
            type="button"
            class="cat-card panel-cristal"
            data-cat-card
            data-glass
            data-cursor-grow
            data-cat-id={cat.id}
            style={`--cat-color: ${cat.data.color}`}
            aria-controls={`panel-${cat.id}`}
          >
            <span class="cat-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-8 font-display text-[28px] font-bold leading-tight tracking-tight">{cat.data.titulo}</h3>
            <p class="mt-4 text-left text-[16px] text-mute">{cat.data.descripcion}</p>
          </button>
        ))
      }
    </div>

    {
      grupos.map((cat) => (
        <article
          id={`panel-${cat.id}`}
          class="cat-panel panel-cristal"
          data-cat-panel
          data-glass
          data-cat-id={cat.id}
          aria-hidden="true"
        >
          <div class="relative z-[1] flex items-start justify-between gap-8">
            <div>
              <p class="text-sm font-semibold" style={`color: ${cat.data.color}`}>
                {cat.data.titulo}
              </p>
              <p class="mt-3 max-w-3xl text-mute">{cat.data.descripcion}</p>
            </div>
            <button type="button" class="btn-pildora btn-pildora--ghost" data-cerrar-categoria aria-label={`Cerrar ${cat.data.titulo}`}>
              Cerrar
            </button>
          </div>
          <div class="relative z-[1] mt-8 grid max-h-[70vh] grid-cols-1 gap-5 overflow-auto pr-2">
            {cat.entradas.length > 0 ? (
              cat.entradas.map((entrada) => <EntradaDiario entrada={entrada} compacta />)
            ) : (
              <p class="text-mute">Aún no hay entradas asociadas a esta categoría.</p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
