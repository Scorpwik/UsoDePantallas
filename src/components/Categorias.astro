---
import type { CollectionEntry } from 'astro:content';
import EntradaDiario from './EntradaDiario.astro';

interface Props {
  categorias: CollectionEntry<'categorias'>[];
  diario: CollectionEntry<'diario'>[];
}

const { categorias, diario } = Astro.props;

const etiquetas = Object.fromEntries(categorias.map((cat) => [cat.id, cat.data.titulo]));

const grupos = categorias.map((cat) => ({
  ...cat,
  entradas: diario.filter((entrada) =>
    (entrada.data.categorias as string[]).includes(cat.id),
  ),
}));

const conteo = categorias
  .map((cat) => ({
    id: cat.id,
    titulo: cat.data.titulo,
    n: diario.filter((entrada) => entrada.data.categorias.includes(cat.id)).length,
  }))
  .sort((a, b) => b.n - a.n);

const max = conteo[0]?.n ?? 0;
---

<section id="categorias" class="seccion categorias-seccion" data-recorrido-seccion>
  <div class="envolvente">
    <header data-bloque>
      <span class="num-seccion">07 · Categorías culturales</span>
      <h2 class="titulo-seccion">Categorías culturales</h2>
    </header>

    <div class="categorias-stage mt-10">
      <div class="categorias-layout grid grid-cols-[1.1fr_0.9fr] items-start gap-16">
        <div class="categorias-deck" data-cat-deck>
        {
          grupos.map((cat, i) => (
            <button
              type="button"
              class="cat-card tarjeta"
              data-cat-card
              data-cursor-grow
              data-cat-id={cat.id}
              style={`--cat-color: ${cat.data.color}`}
              aria-controls={`panel-${cat.id}`}
              aria-expanded="false"
            >
              <span class="cat-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="subtitulo mt-6">{cat.data.titulo}</h3>
              <p class="mt-4 text-left text-arena">{cat.data.descripcion}</p>
            </button>
          ))
        }
        </div>

        <div class="categorias-frecuentes" data-bloque>
          <h3 class="subtitulo">Categorías más frecuentes</h3>
          <p class="prosa mt-4">
            Contadas sobre las entradas del diario. Un mismo episodio puede cargar más de una categoría.
          </p>
          <ul class="mt-6 space-y-4" aria-label="Frecuencia de categorías">
            {
              conteo.map((cat) => (
                <li>
                  <div class="flex items-baseline justify-between gap-6">
                    <p class="text-texto">{cat.titulo}</p>
                    <p class="font-display text-xl font-bold text-enfasis">{cat.n}</p>
                  </div>
                  <span class="mt-2 block h-[3px] rounded-full bg-panel" aria-hidden="true">
                    <span
                      class="block h-full rounded-full bg-enfasis"
                      style={`width: ${max > 0 ? (cat.n / max) * 100 : 0}%`}
                    />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {
        grupos.map((cat) => (
          <article
            id={`panel-${cat.id}`}
            class="cat-panel"
            data-cat-panel
            data-cat-id={cat.id}
            aria-hidden="true"
            role="dialog"
            aria-label={cat.data.titulo}
          >
            <div class="flex shrink-0 items-start justify-between gap-8">
              <div>
                <p class="text-sm font-semibold" style={`color: ${cat.data.color}`}>
                  {cat.data.titulo}
                </p>
                <p class="mt-3 max-w-[680px] text-arena">{cat.data.descripcion}</p>
              </div>
              <button
                type="button"
                class="btn-pildora btn-pildora--ghost shrink-0"
                data-cerrar-categoria
                aria-label={`Cerrar ${cat.data.titulo}`}
              >
                Cerrar
              </button>
            </div>
            <div class="cat-panel-entradas">
              {cat.entradas.length > 0 ? (
                cat.entradas.map((entrada) => (
                  <EntradaDiario entrada={entrada} compacta etiquetas={etiquetas} />
                ))
              ) : (
                <p class="text-arena">Aún no hay entradas asociadas a esta categoría.</p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
