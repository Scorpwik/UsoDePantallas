---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entrada: CollectionEntry<'secciones'>;
  objetivos: string[];
}

const { entrada, objetivos } = Astro.props;

const hallazgos = [
  {
    hallazgo:
      'Cuando el niño está solo, aburrido o esperando. También aparece mientras la mamá come.',
    respuesta: 'El celular aparece en esos momentos, no como algo que se usa todo el tiempo.',
  },
  {
    hallazgo:
      'En la mayoría de las escenas aísla. El niño o la niña están en su pantalla y casi no hablan con quien tienen al lado.',
    respuesta:
      'Solo en la familia hay algo compartido, pero la niña igual está con el celular.',
  },
  {
    hallazgo:
      'Comen o hablan entre ellos, pero casi no hablan con el niño que tiene el celular.',
    respuesta: 'En el caso del niño solo, no vi a ningún adulto cerca.',
  },
];

const bloques = objetivos.map((objetivo, i) => ({
  objetivo,
  ...(hallazgos[i] ?? {
    hallazgo: 'El material aún no cubre este objetivo con un episodio completo.',
    respuesta: 'Hace falta otra salida de campo para responder con la misma densidad.',
  }),
}));
---

<section id="conclusiones" class="seccion" data-recorrido-seccion>
  <div class="envolvente">
    <span class="num-seccion">08 · Conclusiones</span>
    <h2 class="titulo-seccion">{entrada.data.titulo}</h2>

    <ol class="mt-12 space-y-4">
      {
        bloques.map((bloque, i) => (
          <li class="tarjeta grid grid-cols-3 gap-8" data-bloque>
            <div>
              <p class="font-display text-[40px] font-bold leading-none text-enfasis">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-4 text-sm font-semibold text-texto">Objetivo</h3>
              <p class="mt-2 text-arena">{bloque.objetivo}</p>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-texto">Hallazgo</h3>
              <p class="mt-2 text-arena">{bloque.hallazgo}</p>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-texto">Respuesta</h3>
              <p class="mt-2 text-arena">{bloque.respuesta}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
