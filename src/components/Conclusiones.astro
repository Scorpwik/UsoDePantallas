---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entrada: CollectionEntry<'secciones'>;
  objetivos: string[];
  categorias: CollectionEntry<'categorias'>[];
  diario: CollectionEntry<'diario'>[];
}

const { entrada, objetivos, categorias, diario } = Astro.props;
const { Content } = await render(entrada);

const hallazgos = [
  {
    hallazgo:
      'Cuando el niño está solo, aburrido o esperando. También aparece mientras la mamá come.',
    respuesta: 'El celular aparece en esos momentos, no como algo que se usa todo el tiempo.',
  },
  {
    hallazgo:
      'En la mayoría de las escenas aísla. El niño o la niña están en su pantalla y casi no hablan con quien tienen al lado.',
    respuesta:
      'Solo en la familia hay algo compartido, pero la niña igual está con el celular.',
  },
  {
    hallazgo:
      'Comen o hablan entre ellos, pero casi no hablan con el niño que tiene el celular.',
    respuesta: 'En el caso del niño solo, no vi a ningún adulto cerca.',
  },
];

const bloques = objetivos.map((objetivo, i) => ({
  objetivo,
  ...(hallazgos[i] ?? {
    hallazgo: 'El material aún no cubre este objetivo con un episodio completo.',
    respuesta: 'Hace falta otra salida de campo para responder con la misma densidad.',
  }),
}));

const conteo = categorias
  .map((cat) => ({
    id: cat.id,
    titulo: cat.data.titulo,
    n: diario.filter((entrada) => entrada.data.categorias.includes(cat.id)).length,
  }))
  .sort((a, b) => b.n - a.n);

const max = conteo[0]?.n ?? 0;
---

<section id="conclusiones" class="seccion">
  <div class="envolvente">
    <span class="num-seccion">08 · {entrada.data.titulo}</span>
    <h2 class="titulo-seccion">{entrada.data.titulo}</h2>
    <p class="cita-destacada mt-8 max-w-[22ch]">
      El celular funciona más como algo que calma un momento difícil que como algo que se usa todo el tiempo.
    </p>

    <ol class="mt-12 space-y-4">
      {
        bloques.map((bloque, i) => (
          <li class="tarjeta grid grid-cols-3 gap-8" data-bloque>
            <div>
              <p class="font-display text-[40px] font-bold leading-none text-enfasis">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-4 text-sm font-semibold text-texto">Objetivo</h3>
              <p class="mt-2 text-arena">{bloque.objetivo}</p>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-texto">Hallazgo</h3>
              <p class="mt-2 text-arena">{bloque.hallazgo}</p>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-texto">Respuesta</h3>
              <p class="mt-2 text-arena">{bloque.respuesta}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-12" data-bloque>
      <h3 class="subtitulo">Categorías más frecuentes</h3>
      <p class="prosa mt-4">
        Contadas sobre las entradas del diario. Un mismo episodio puede cargar más de una categoría.
      </p>
      <ul class="mt-6 space-y-4" aria-label="Frecuencia de categorías">
        {
          conteo.map((cat) => (
            <li>
              <div class="flex items-baseline justify-between gap-6">
                <p class="text-texto">{cat.titulo}</p>
                <p class="font-display text-xl font-bold text-turquesa">{cat.n}</p>
              </div>
              <span
                class="mt-2 block h-[3px] rounded-full bg-panel"
                aria-hidden="true"
              >
                <span
                  class="block h-full rounded-full bg-turquesa"
                  style={`width: ${max > 0 ? (cat.n / max) * 100 : 0}%`}
                />
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="prosa mt-12" data-bloque>
      <Content />
    </div>
  </div>
</section>
