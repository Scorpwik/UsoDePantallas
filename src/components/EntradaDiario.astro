---
import type { CollectionEntry } from 'astro:content';
import ImagenCampo from './ImagenCampo.astro';
import PanelCristal from './PanelCristal.astro';

interface Props {
  entrada: CollectionEntry<'diario'>;
  compacta?: boolean;
  eager?: boolean;
  etiquetas?: Record<string, string>;
}

const { entrada, compacta = false, eager = false, etiquetas = {} } = Astro.props;
const d = entrada.data;
const fecha = d.fecha.toLocaleDateString('es-EC', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const nombres = d.categorias.map((id) => etiquetas[id] ?? id);
---

<article class:list={['cat-entrada', compacta && 'h-full']} id={compacta ? undefined : `entrada-${entrada.id}`}>
  {
    compacta ? (
      <div class="tarjeta entrada-compacta h-full overflow-hidden !p-0">
        <div class="entrada-compacta-foto">
          <ImagenCampo
            src={d.imagenPrincipal}
            alt={`Registro visual desenfocado de ${d.espacio}. ${d.notaPrivacidad}`}
            eager={eager}
            width={900}
            height={675}
          />
        </div>
        <div class="entrada-compacta-texto">
          <p class="entrada-cuando">
            {fecha} · {d.hora}
          </p>
          <p class="entrada-donde">{d.espacio}</p>
          <h3 class="entrada-titulo">{d.titulo}</h3>
          <p class="entrada-resumen">{d.descripcion}</p>
        </div>
      </div>
    ) : (
      <PanelCristal class="entrada-panel overflow-hidden" revelar={false}>
        <header class="entrada-cabecera">
          <p class="entrada-cuando">
            {fecha} · {d.hora}
          </p>
          <p class="entrada-donde">{d.espacio}</p>
          <h3 class="entrada-titulo">{d.titulo}</h3>
        </header>

        <div class="entrada-cuerpo">
          <figure class="entrada-foto" data-cursor-img tabindex="0" role="button" aria-label={`Ampliar foto de ${d.espacio}`}>
            <ImagenCampo
              src={d.imagenPrincipal}
              alt={`Registro visual desenfocado de ${d.espacio}. ${d.notaPrivacidad}`}
              eager={eager}
              width={1200}
              height={900}
            />
          </figure>

          <div class="entrada-notas">
            <section class="entrada-bloque">
              <h4>Descripción de la escena</h4>
              <p>{d.descripcion}</p>
            </section>
            <section class="entrada-bloque">
              <h4>Impresiones sensoriales</h4>
              <ul class="entrada-lista">
                {d.impresiones.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          </div>
        </div>

        <section class="entrada-reflexion entrada-bloque">
          <h4>Impresiones y reflexiones como investigador</h4>
          <p>{d.reflexion}</p>
          {
            d.frases.length > 0 && (
              <blockquote class="cita-destacada">“{d.frases[0]}”</blockquote>
            )
          }
        </section>

        <footer class="entrada-pie">
          <div class="entrada-bloque">
            <h4>Categorías identificadas</h4>
            <ul class="entrada-chips">
              {nombres.map((nombre) => (
                <li class="chip">{nombre}</li>
              ))}
            </ul>
          </div>
          <p class="entrada-privacidad">{d.notaPrivacidad}</p>
        </footer>
      </PanelCristal>
    )
  }
</article>
