---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entrada: CollectionEntry<'secciones'>;
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const { titulo, tema, contexto, lugares = [] } = entrada.data;
const etiquetaSeccion = tema ?? titulo;
---

<section id="escena" class="seccion" data-recorrido-seccion>
  <div class="envolvente">
    <div class="grid grid-cols-[1.1fr_0.9fr] gap-16">
      <div data-bloque>
        <span class="num-seccion">04 · {etiquetaSeccion}</span>
        {
          tema ? (
            <>
              <h2 class="titulo-seccion">{tema}</h2>
              <p class="titulo-seccion-apoyo text-texto">{titulo}</p>
            </>
          ) : (
            <h2 class="titulo-seccion">{titulo}</h2>
          )
        }
      </div>
      <div class="space-y-8 pt-8" data-bloque>
        {contexto && <p class="cita-destacada">{contexto}</p>}
      </div>
    </div>

    <div class="prosa mt-10" data-bloque>
      <Content />
    </div>

    {
      lugares.length > 0 && (
        <div class="lugares-grid mt-12" data-lugares>
          {lugares.map((lugar, i) => (
            <article class="tarjeta" data-lugar>
              <p class="font-display text-[40px] font-bold leading-none text-enfasis">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="subtitulo mt-6">{lugar.nombre}</h3>
              <p class="mt-4 text-arena">{lugar.descripcion}</p>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
