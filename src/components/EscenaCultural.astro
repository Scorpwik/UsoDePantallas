---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entrada: CollectionEntry<'secciones'>;
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const { titulo, contexto, significados, lugares = [] } = entrada.data;
const cita =
  'En estas escenas, la pantalla no significa solo entretenimiento. Significa tregua, recompensa, prueba de que el adulto está gestionando la situación.';
---

<section id="escena" class="seccion">
  <div class="envolvente">
    <div class="grid grid-cols-[1.1fr_0.9fr] gap-16">
      <div data-bloque>
        <span class="num-seccion">04 · {titulo}</span>
        <h2 class="titulo-seccion">{titulo}</h2>
        {contexto && <p class="prosa mt-8">{contexto}</p>}
      </div>
      <div class="space-y-8 pt-8" data-bloque>
        {significados && <p class="cita-destacada">{cita}</p>}
        <div class="prosa">
          <Content />
        </div>
        {significados && <p class="prosa">{significados}</p>}
      </div>
    </div>

    {
      lugares.length > 0 && (
        <div class="lugares-grid mt-12" data-lugares>
          {lugares.map((lugar, i) => (
            <article class="tarjeta" data-lugar>
              <p class="font-display text-[40px] font-bold leading-none text-enfasis">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="subtitulo mt-6">{lugar.nombre}</h3>
              <p class="mt-4 text-arena">{lugar.descripcion}</p>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
