---
import { render, type CollectionEntry } from 'astro:content';
import PanelCristal from './PanelCristal.astro';

interface Props {
  entrada: CollectionEntry<'secciones'>;
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const { titulo, contexto, significados, salidasCampo = [] } = entrada.data;
---

<section id="escena" class="seccion" data-clip>
  <div class="envolvente grid grid-cols-2 gap-16">
    <div>
      <p class="kicker">04</p>
      <h2 class="titulo-seccion">{titulo}</h2>
      {
        contexto && (
          <div class="mt-10">
            <h3 class="mb-3 font-display text-2xl font-bold">Contexto</h3>
            <p class="prosa" data-revelar>{contexto}</p>
          </div>
        )
      }
    </div>
    <div class="space-y-6">
      {
        significados && (
          <PanelCristal class="p-8">
            <h3 class="mb-3 font-display text-2xl font-bold">Significados compartidos</h3>
            <p class="text-mute" data-revelar>{significados}</p>
          </PanelCristal>
        )
      }
      <div class="prosa">
        <Content />
      </div>
    </div>
  </div>

  {
    salidasCampo.length > 0 && (
      <div class="envolvente mt-8">
        <h3 class="font-display text-3xl font-bold tracking-tight">Línea de tiempo de las salidas</h3>
        <ol class="linea-tiempo mt-10">
          {salidasCampo.map((salida) => (
            <li data-objetivo>
              <p class="text-sm font-semibold text-porsche">{salida.fecha}</p>
              <p class="mt-1 font-display text-xl font-bold">{salida.lugar}</p>
              <p class="mt-2 max-w-3xl text-mute">{salida.nota}</p>
            </li>
          ))}
        </ol>
      </div>
    )
  }
</section>
