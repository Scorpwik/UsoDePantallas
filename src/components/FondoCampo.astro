---
interface Props {
  imagenes?: string[];
}

const { imagenes = [] } = Astro.props;
const fotos = [...new Set(imagenes.filter(Boolean))].slice(0, 4);
---

<div class="fondo-campo" aria-hidden="true">
  {
    fotos.map((src, i) => (
      <img
        src={src}
        alt=""
        class={`fondo-campo-foto fondo-campo-foto--${i + 1}`}
        data-fondo-foto
        loading="eager"
        decoding="async"
      />
    ))
  }
  <div class="fondo-mancha-wrap" data-fondo-mancha-scroll>
    <div class="fondo-mancha fondo-mancha--cafe" data-fondo-blob></div>
  </div>
  <div class="fondo-mancha-wrap" data-fondo-mancha-scroll>
    <div class="fondo-mancha fondo-mancha--turquesa" data-fondo-blob></div>
  </div>
  <div class="fondo-mancha-wrap" data-fondo-mancha-scroll>
    <div class="fondo-mancha fondo-mancha--panel" data-fondo-blob></div>
  </div>
  <div class="fondo-mancha-wrap" data-fondo-mancha-scroll>
    <div class="fondo-mancha fondo-mancha--mostaza" data-fondo-blob></div>
  </div>
  <div class="fondo-luz fondo-luz--turquesa" data-fondo-luz></div>
  <div class="fondo-luz fondo-luz--oro" data-fondo-luz></div>
  <div class="fondo-luz fondo-luz--sombra" data-fondo-luz></div>
  <div class="fondo-campo-gradiente"></div>
  <div class="fondo-grano"></div>
</div>
