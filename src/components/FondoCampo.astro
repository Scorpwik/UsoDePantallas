---
interface Props {
  imagenes?: string[];
}

const { imagenes = [] } = Astro.props;
const fotos = [...new Set(imagenes.filter(Boolean))].slice(0, 4);
---

<div class="fondo-campo" aria-hidden="true">
  {
    fotos.map((src, i) => (
      <img
        src={src}
        alt=""
        class={`fondo-campo-foto fondo-campo-foto--${i + 1}`}
        data-fondo-foto
        loading="eager"
        decoding="async"
      />
    ))
  }
  <div class="fondo-blob fondo-blob--turquesa" data-fondo-blob></div>
  <div class="fondo-blob fondo-blob--mostaza" data-fondo-blob></div>
  <div class="fondo-blob fondo-blob--cafe" data-fondo-blob></div>
  <div class="fondo-campo-gradiente"></div>
  <div class="fondo-grano"></div>
</div>
