---
interface Props {
  titulo: string;
  subtitulo: string;
  autor: string;
  docente: string;
  materia: string;
  fecha: Date;
  ciudad: string;
  salidas: number;
  observaciones: number;
  entradasDiario: number;
}

const {
  titulo,
  subtitulo,
  autor,
  docente,
  materia,
  fecha,
  ciudad,
  salidas,
  observaciones,
  entradasDiario,
} = Astro.props;

const fechaLarga = fecha.toLocaleDateString('es-EC', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<header id="inicio" class="hero">
  <div class="hero-blob" aria-hidden="true"></div>
  <canvas id="particulas-hero" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="envolvente hero-copy">
    <p class="kicker">{materia} · {ciudad}</p>
    <h1>{titulo}</h1>
    <p class="prosa mt-8 text-[22px] text-paper" data-revelar>{subtitulo}</p>
    <dl class="mt-12 grid max-w-3xl grid-cols-2 gap-x-12 gap-y-5 text-[15px] text-mute">
      <div>
        <dt class="text-paper/70">Autor</dt>
        <dd class="text-paper">{autor}</dd>
      </div>
      <div>
        <dt class="text-paper/70">Docente</dt>
        <dd class="text-paper">{docente}</dd>
      </div>
      <div>
        <dt class="text-paper/70">Entrega</dt>
        <dd class="text-paper capitalize">{fechaLarga}</dd>
      </div>
      <div>
        <dt class="text-paper/70">Materia</dt>
        <dd class="text-paper">{materia}</dd>
      </div>
    </dl>
    <ul class="mt-16 flex gap-10" aria-label="Cifras de la investigación">
      <li>
        <p class="cifra" data-contador={String(salidas)}>00</p>
        <p class="mt-2 text-sm text-mute">Salidas de campo</p>
      </li>
      <li>
        <p class="cifra" data-contador={String(observaciones)}>00</p>
        <p class="mt-2 text-sm text-mute">Observaciones</p>
      </li>
      <li>
        <p class="cifra" data-contador={String(entradasDiario)}>00</p>
        <p class="mt-2 text-sm text-mute">Entradas del diario</p>
      </li>
    </ul>
  </div>
</header>
