---
import ImagenCampo from './ImagenCampo.astro';

interface Props {
  titulo: string;
  subtitulo: string;
  autor: string;
  docente: string;
  materia: string;
  ciudad: string;
  salidas: number;
  observaciones: number;
  entradasDiario: number;
  fotos?: string[];
}

const {
  titulo,
  subtitulo,
  autor,
  docente,
  materia,
  ciudad,
  salidas,
  observaciones,
  entradasDiario,
  fotos = [],
} = Astro.props;

const unicas = [...new Set(fotos.filter(Boolean))];
const filaA = unicas.length ? [...unicas, ...unicas] : [];
const filaB = unicas.length ? [...unicas.slice().reverse(), ...unicas.slice().reverse()] : [];
---

<header id="inicio" class="hero">
  <div class="hero-orbita" aria-hidden="true">
    <span class="hero-anillo hero-anillo--a"></span>
    <span class="hero-anillo hero-anillo--b"></span>
  </div>
  <div class="hero-escena">
    <div class="hero-copy">
      <div>
        <span class="num-seccion">01 · {materia} · {ciudad}</span>
        <h1 data-hero-titulo>{titulo}</h1>
        {subtitulo && <p class="prosa mt-6 text-texto" data-bloque>{subtitulo}</p>}
        <dl class="hero-meta" data-bloque>
          <div>
            <dt class="text-arena">Autor</dt>
            <dd class="text-texto">{autor}</dd>
          </div>
          <div>
            <dt class="text-arena">Docente</dt>
            <dd class="text-texto">{docente}</dd>
          </div>
          <div>
            <dt class="text-arena">Materia</dt>
            <dd class="text-texto">{materia}</dd>
          </div>
        </dl>
      </div>
      <ul class="hero-cifras" aria-label="Cifras de la investigación">
        <li>
          <p class="cifra" data-contador={String(salidas)} data-contador-carga>00</p>
          <p class="mt-2 text-sm text-arena">Salidas de campo</p>
        </li>
        <li>
          <p class="cifra" data-contador={String(observaciones)} data-contador-carga>00</p>
          <p class="mt-2 text-sm text-arena">Observaciones</p>
        </li>
        <li>
          <p class="cifra" data-contador={String(entradasDiario)} data-contador-carga>00</p>
          <p class="mt-2 text-sm text-arena">Entradas del diario</p>
        </li>
      </ul>
    </div>

    {
      filaA.length > 0 && (
        <aside class="hero-carrusel" data-hero-carrusel aria-hidden="true">
          <div class="hero-carrusel-fila">
            <div class="hero-carrusel-track" data-hero-track="a">
              {filaA.map((src, i) => (
                <div class="hero-carrusel-foto">
                  <ImagenCampo src={src} alt="" width={420} height={525} eager={i < 2} />
                </div>
              ))}
            </div>
          </div>
          <div class="hero-carrusel-fila">
            <div class="hero-carrusel-track" data-hero-track="b">
              {filaB.map((src) => (
                <div class="hero-carrusel-foto hero-carrusel-foto--baja">
                  <ImagenCampo src={src} alt="" width={380} height={475} />
                </div>
              ))}
            </div>
          </div>
        </aside>
      )
    }
  </div>
</header>
