---
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  eager?: boolean;
}

const { src, alt, class: className, width = 1600, height = 1000, eager = false } = Astro.props;
const esRaster = /\.(jpe?g|png|webp|avif)$/i.test(src);
const webp = esRaster ? src.replace(/\.(jpe?g|png)$/i, '.webp') : src;
---

{
  esRaster ? (
    <picture>
      <source srcset={webp} type="image/webp" />
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        class:list={['img-campo', className]}
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      class:list={['img-campo', className]}
    />
  )
}
