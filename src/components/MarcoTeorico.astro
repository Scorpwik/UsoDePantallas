---
import { render, type CollectionEntry } from 'astro:content';
import PanelCristal from './PanelCristal.astro';

/**
 * Desactivado en la página principal por ahora.
 * El contenido sigue editable en Decap CMS (sección marco-teorico).
 * Para reactivarlo: importa y renderiza en index.astro, y vuelve a añadir el enlace en Navbar.
 */
interface Props {
  entrada: CollectionEntry<'secciones'>;
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const { titulo, factoresParentales = [], impactoDesarrollo = [] } = entrada.data;
const cita =
  'La pantalla no se trata aquí como un aparato neutral, sino como un actor que reordena miradas, turnos de habla y distancias entre cuerpos.';

const spansFactores = ['bento-7', 'bento-5', 'bento-5', 'bento-7'];
const spansImpacto = ['bento-4', 'bento-8', 'bento-6', 'bento-6'];
---

<section id="marco-teorico" class="seccion">
  <div class="envolvente">
    <span class="num-seccion">{titulo}</span>
    <div class="bento">
      <div class="bento-7" data-bloque>
        <h2 class="titulo-seccion">{titulo}</h2>
        <div class="prosa mt-8">
          <Content />
        </div>
      </div>
      <PanelCristal class="bento-5 flex items-end">
        <p class="cita-destacada">{cita}</p>
      </PanelCristal>
    </div>

    <h3 class="subtitulo mt-16">Factores parentales</h3>
    <div class="bento mt-6">
      {
        factoresParentales.map((factor, i) => (
          <PanelCristal class={`${spansFactores[i] ?? 'bento-6'}`} data-bloque>
            <h4 class="subtitulo">{factor.titulo}</h4>
            <p class="mt-4 max-w-[48ch] text-arena">{factor.texto}</p>
          </PanelCristal>
        ))
      }
    </div>

    <h3 class="subtitulo mt-16">Impacto en el desarrollo</h3>
    <div class="bento mt-6">
      {
        impactoDesarrollo.map((item, i) => (
          <PanelCristal class={`${spansImpacto[i] ?? 'bento-6'}`} data-bloque>
            <h4 class="subtitulo">{item.titulo}</h4>
            <p class="mt-4 max-w-[48ch] text-arena">{item.texto}</p>
          </PanelCristal>
        ))
      }
    </div>
  </div>
</section>
