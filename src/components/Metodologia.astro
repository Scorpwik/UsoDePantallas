---
import { render, type CollectionEntry } from 'astro:content';
import PanelCristal from './PanelCristal.astro';

interface Props {
  entrada: CollectionEntry<'secciones'>;
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const { titulo, enfoque, posicion, etica } = entrada.data;
const cita = 'La unidad de análisis es el episodio.';

const bloques = [
  { titulo: 'Enfoque', texto: enfoque },
  { titulo: 'Rol del observador', texto: posicion },
  { titulo: 'Consideraciones éticas', texto: etica },
].filter((b) => b.texto);
---

<section id="metodologia" class="seccion">
  <div class="envolvente metodologia-grid">
    <div>
      <span class="num-seccion">03 · Método</span>
      <h2 class="titulo-seccion">{titulo}</h2>
      <p class="cita-destacada mt-10 max-w-[14ch]">{cita}</p>
    </div>
    <div class="space-y-4">
      {
        bloques.map((bloque) => (
          <PanelCristal data-bloque>
            <h3 class="subtitulo">{bloque.titulo}</h3>
            <p class="mt-4 text-arena">{bloque.texto}</p>
          </PanelCristal>
        ))
      }
      <div class="prosa pt-4" data-bloque>
        <Content />
      </div>
    </div>
  </div>
</section>
