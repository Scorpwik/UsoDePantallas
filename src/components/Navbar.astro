---
interface Props {
  actual?: 'inicio' | 'diario';
}

const { actual = 'inicio' } = Astro.props;
const enDiario = actual === 'diario';
const origen = enDiario ? '/' : '';

const enlaces = [
  { href: `${origen}#inicio`, label: 'Inicio' },
  { href: `${origen}#planteamiento`, label: 'Planteamiento' },
  { href: `${origen}#metodologia`, label: 'Metodología' },
  { href: `${origen}#escena`, label: 'Escena cultural' },
  { href: `${origen}#reflexividad`, label: 'Reflexividad' },
  { href: '/diario', label: 'Diario de campo', pagina: 'diario' },
  { href: `${origen}#categorias`, label: 'Categorías' },
  { href: `${origen}#conclusiones`, label: 'Conclusiones' },
  { href: `${origen}#reflexion`, label: 'Reflexión sobre el proceso' },
  { href: `${origen}#referencias`, label: 'Referencias' },
  { href: `${origen}#pie`, label: 'Pie' },
];
---

<nav class="navbar" data-nav aria-label="Secciones del informe">
  <a class="navbar-marca" href={`${origen}#inicio`}>Uso de pantallas</a>
  <div class="navbar-links">
    <span class="navbar-indicador" data-nav-indicador aria-hidden="true"></span>
    {
      enlaces.map((enlace) => (
        <a
          href={enlace.href}
          aria-current={enlace.pagina === actual ? 'page' : undefined}
        >
          {enlace.label}
        </a>
      ))
    }
  </div>
</nav>
