---
const enlaces = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#planteamiento', label: 'Planteamiento' },
  { href: '#reflexividad', label: 'Reflexividad' },
  { href: '#escena', label: 'Escena cultural' },
  { href: '#diario', label: 'Diario de campo' },
  { href: '#categorias', label: 'Categorías' },
  { href: '#conclusiones', label: 'Conclusiones' },
  { href: '#reflexion', label: 'Reflexión sobre el proceso' },
  { href: '#referencias', label: 'Referencias' },
];
---

<nav class="navbar" data-nav aria-label="Secciones del informe">
  <a class="navbar-marca" href="#inicio">Uso de pantallas</a>
  <div class="navbar-links">
    <span class="navbar-indicador" data-nav-indicador aria-hidden="true"></span>
    {
      enlaces.map((enlace) => (
        <a href={enlace.href} aria-current={enlace.href === '#inicio' ? 'location' : undefined}>
          {enlace.label}
        </a>
      ))
    }
  </div>
</nav>
