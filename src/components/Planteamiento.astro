---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entrada: CollectionEntry<'secciones'>;
}

const { entrada } = Astro.props;
const { titulo, pregunta, objetivoGeneral, objetivosEspecificos = [] } = entrada.data;
---

<section id="planteamiento" class="seccion" data-recorrido-seccion>
  <div class="envolvente">
    <span class="num-seccion">02 · {titulo}</span>
    {
      pregunta && (
        <h2 class="titulo-seccion max-w-[22ch]" data-bloque>
          {pregunta}
        </h2>
      )
    }

    {
      objetivoGeneral && (
        <div class="mt-12" data-bloque>
          <h3 class="subtitulo">Objetivo general</h3>
          <p class="prosa mt-4 text-texto">{objetivoGeneral}</p>
        </div>
      )
    }

    {
      objetivosEspecificos.length > 0 && (
        <div class="mt-12">
          <h3 class="subtitulo">Objetivos específicos</h3>
          <ol class="mt-4">
            {objetivosEspecificos.map((objetivo, i) => (
              <li class="objetivo-banda" data-bloque>
                <span class="font-display text-[40px] font-bold leading-none text-enfasis">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="max-w-[680px] pt-1 text-texto">{objetivo}</p>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>
