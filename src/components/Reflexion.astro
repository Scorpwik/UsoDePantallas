---
import { render, type CollectionEntry } from 'astro:content';
import PanelCristal from './PanelCristal.astro';

interface Props {
  entrada: CollectionEntry<'secciones'>;
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const { titulo, comoObservar, retos = [], sorpresas = [], diferente } = entrada.data;
const cita =
  'En un lugar diseñado para no detenerse, la investigación consiste precisamente en detenerse y en aceptar que una parte de lo que ocurre no se puede mostrar con el rostro de quien lo vive.';
---

<section id="reflexion" class="seccion">
  <div class="envolvente">
    <span class="num-seccion">09 · {titulo}</span>
    <h2 class="titulo-seccion">{titulo}</h2>

    <blockquote class="bloque-cierre mt-10" data-bloque>
      <p>{cita}</p>
    </blockquote>

    <div class="mt-10 grid grid-cols-2 gap-4">
      <PanelCristal data-bloque>
        <h3 class="subtitulo">Cómo fue observar</h3>
        {comoObservar && <p class="mt-4 text-arena">{comoObservar}</p>}
        <div class="prosa mt-4">
          <Content />
        </div>
      </PanelCristal>
      <PanelCristal data-bloque>
        <h3 class="subtitulo">Retos</h3>
        <ul class="mt-4 space-y-4 text-arena">
          {retos.map((reto) => (
            <li>{reto}</li>
          ))}
        </ul>
      </PanelCristal>
      <PanelCristal data-bloque>
        <h3 class="subtitulo">Lo que me sorprendió</h3>
        <ul class="mt-4 space-y-4 text-arena">
          {sorpresas.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </PanelCristal>
      {
        diferente && (
          <PanelCristal data-bloque>
            <h3 class="subtitulo">Lo que haría diferente</h3>
            <p class="mt-4 text-arena">{diferente}</p>
          </PanelCristal>
        )
      }
    </div>
  </div>
</section>
