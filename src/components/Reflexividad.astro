---
import { render, type CollectionEntry } from 'astro:content';
import PanelCristal from './PanelCristal.astro';

interface Props {
  entrada: CollectionEntry<'secciones'>;
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const { titulo, posicion, participacion, sesgo } = entrada.data;
const textoParticipacion =
  participacion ??
  'Solo observé desde afuera con el objetivo de no intervenir en la escena y dejar que todas las cosas sucedieran con naturalidad, sin que fueran fingidas ni condicionadas.';
---

<section id="reflexividad" class="seccion" data-recorrido-seccion>
  <div class="envolvente">
    <span class="num-seccion">03 · {titulo}</span>
    <h2 class="titulo-seccion" data-recorrido-ancla>{titulo}</h2>
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        posicion && (
          <PanelCristal data-bloque>
            <h3 class="subtitulo">Posición como investigador</h3>
            <p class="mt-4 text-arena">{posicion}</p>
          </PanelCristal>
        )
      }
      {
        sesgo && (
          <PanelCristal data-bloque>
            <h3 class="subtitulo">Cómo pudo influir</h3>
            <p class="mt-4 text-arena">{sesgo}</p>
          </PanelCristal>
        )
      }
      <PanelCristal data-bloque>
        <h3 class="subtitulo">Nivel de participación: no participante</h3>
        <p class="mt-4 text-arena">{textoParticipacion}</p>
      </PanelCristal>
    </div>

    <div class="prosa mt-10" data-bloque>
      <Content />
    </div>
  </div>
</section>
